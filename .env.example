# ---------------------------------------------------------------------------
# Clause — environment variables
# ---------------------------------------------------------------------------
# All values are read SERVER-SIDE only (Cloudflare Worker `env`). None of these
# are ever bundled into client code.
#
# Local development:  copy this file to `.dev.vars` (the Cloudflare Vite plugin
#                     loads `.dev.vars` into the Worker during `npm run dev`).
#                         cp .env.example .dev.vars
# Production (Sites):  set these in the Sites project runtime settings.
# Production (Workers): `npx wrangler secret put GEMINI_API_KEY` etc.
# ---------------------------------------------------------------------------

# --- AI (required for summaries, chat, and semantic search) -----------------
# Google AI Studio key: https://aistudio.google.com/apikey  (free tier is enough)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Email delivery (optional: "email an invite when sharing") --------------
# Resend API key + a verified sender. Leave blank to disable email; share links
# still work and are shown in the UI to copy manually.
RESEND_API_KEY=
EMAIL_FROM=Clause <noreply@example.com>

# --- App URL (used to build share links inside emails) ---------------------
# Local dev default is the Vite port. In production set your deployed origin,
# e.g. https://clause.example.workers.dev
APP_URL=http://localhost:5173
